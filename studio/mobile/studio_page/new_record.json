   "method": "GET",
   "params": "{\"doctype\":\"{{ sessionStorage.getItem(\\\"doctype\\\") }}\"}",
   "resource_name": "form_schema",
   "resource_type": "API Resource",
   "transform": "function transform(data) {\n  const toOptionArray = (optionsText) =>\n    String(optionsText || \"\")\n      .split(\"\\n\")\n      .map((s) => s.trim())\n      .filter(Boolean)\n      .map((label) => ({\n        label,\n        value: label\n          .toLowerCase()\n          .replace(/&/g, \" and \")\n          .replace(/[^a-z0-9]+/g, \"-\")\n          .replace(/^-+|-+$/g, \"\"),\n      }));\n\n  const toBoolean = (v) => {\n    if (v === true || v === false) return v;\n    if (v === 1 || v === \"1\") return true;\n    if (v === 0 || v === \"0\") return false;\n    if (typeof v === \"string\") {\n      const s = v.trim().toLowerCase();\n      if (s === \"true\") return true;\n      if (s === \"false\") return false;\n    }\n    return false;\n  };\n\n  const toIntBool = (v) => (toBoolean(v) ? 1 : 0);\n\n  const extractParentFromDependsOn = (dependsOn) => {\n    if (typeof dependsOn !== \"string\" || !dependsOn.trim()) return null;\n    const m = dependsOn.match(/\\bdoc\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b/);\n    return m ? m[1] : null;\n  };\n\n  if (!data || !Array.isArray(data.docs)) return data;\n\n  // Shared visibility state across fields/components\n  globalThis.__switchState = globalThis.__switchState || {};\n\n  return {\n    ...data,\n    docs: data.docs.map((doc) => {\n      if (!doc || !Array.isArray(doc.fields)) return doc;\n\n      // First pass: normalize fields + capture values by fieldname\n      const byFieldname = {};\n      const normalizedFields = doc.fields.map((field) => {\n        const fieldtype = (field?.fieldtype || \"\").toLowerCase();\n        const out = { ...field };\n\n        // Always set parent_link explicitly (string or null)\n        out.parent_link = extractParentFromDependsOn(field?.depends_on);\n\n        // Select: newline options -> [{label,value}]\n        if (fieldtype === \"select\" && typeof field?.options === \"string\") {\n          out.options = toOptionArray(field.options);\n        }\n\n        // Check: