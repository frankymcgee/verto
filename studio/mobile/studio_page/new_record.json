 "resources": [
  {
   "document_type": "Studio Page",
   "fields": "[\"page_name\",\"page_title\",\"route\"]",
   "filters": "{\"studio_app\":[\"=\",\"mobile\"],\"dynamic_page\":[\"=\",\"No\"]}",
   "method": "GET",
   "params": "{}",
   "resource_name": "Page_List",
   "resource_type": "Document List",
   "transform": "function transform(data) {\n  const rows = Array.isArray(data) ? [...data] : [];\n\n  const iconFor = (title) => {\n    const t = (title || \"\").toLowerCase();\n    if (t.includes(\"home\")) return \"home\";\n    if (t.includes(\"shift\")) return \"calendar\";\n    return \"circle\";\n  };\n\n  // Your desired order (after Home)\n  const ORDER = [\n    \"Shifts\",\n    // \"Timesheets\",\n    // \"Messages\",\n    // \"Settings\",\n  ];\n\n  const rank = (title) => {\n    if (title === \"Home\") return -1000;              // always first\n    const i = ORDER.indexOf(title);\n    if (i !== -1) return i;                          // custom order next\n    return 1000;                                     // everything else after\n  };\n\n  rows.sort((a, b) => {\n    const at = a.page_title || \"\";\n    const bt = b.page_title || \"\";\n\n    const ra = rank(at);\n    const rb = rank(bt);\n    if (ra !== rb) return ra - rb;\n\n    // tie-break: alphabetic\n    return at.localeCompare(bt);\n  });\n\n  return rows.map(r => ({\n    label: r.page_title,\n    route: \"/mobile\" + r.route,\n    icon: iconFor(r.page_title)\n  }));\n}",
   "whitelisted_methods": "[]"
  },
