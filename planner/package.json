{
  "name": "planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite preview",
    "build": "vite build --base=/assets/verto/planner/ && yarn copy-html-entry",
    "copy-html-entry": "mkdir -p ../verto/www && cp ../verto/public/planner/index.html ../verto/www/planner.html",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^4.4.0",
    "autoprefixer": "^10.4.19",
    "dayjs": "^1.11.11",
    "frappe-ui": "1.0.0-beta.64",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.4.3",
    "vite": "^5.4.10",
    "vue": "^3.5.12",
    "vue-router": "^4.3.2",
    "reka-ui": "2.10.4",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.8.4",
    "typescript": "^5.4.5",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
