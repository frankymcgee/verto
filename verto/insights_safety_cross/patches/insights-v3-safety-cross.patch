+++ b/frontend/src2/charts/safetyCross.ts
@@ -0,0 +1,251 @@
+import { SafetyCrossChartConfig } from '../types/chart.types'
+import { QueryResultRow } from '../types/query.types'
+
+export type SafetyStatus = {
+	key: string
+	label: string
+	values: string
+	color: string
+	severity: number
+}
+
+export type SafetyShift = SafetyStatus & {
+	count: number
+	details: string[]
+}
+
+export type SafetyCrossDay = {
+	day: number
+	dayShift: SafetyShift | null
+	nightShift: SafetyShift | null
+}
+
+export const DEFAULT_EMPTY_COLOR = '#E5E7EB'
+
+export const DEFAULT_STATUSES: SafetyStatus[] = [
+	{
+		key: 'safe_shift',
+		label: 'Safe Shift',
+		values: 'Safe Shift',
+		color: '#22C55E',
+		severity: 1,
+	},
+	{
+		key: 'safe_with_improvements',
+		label: 'Safe With Improvements',
+		values: 'Safe With Improvements',
+		color: '#FACC15',
+		severity: 2,
+	},
+	{
+		key: 'unsafe_shift',
+		label: 'Unsafe Shift',
+		values: 'Unsafe Shift',
+		color: '#F97316',
+		severity: 3,
+	},
+	{
+		key: 'unsafe_shift_with_incident',
+		label: 'Unsafe Shift With Incident',
+		values: 'Unsafe Shift With Incident',
+		color: '#DC2626',
+		severity: 4,
+	},
+]
+
+export function normalizeText(value: unknown) {
+	return String(value ?? '')
+		.trim()
+		.toLowerCase()
+		.replace(/[_-]+/g, ' ')
+		.replace(/\s+/g, ' ')
+}
+
+function aliases(value?: string) {
+	return String(value ?? '')
+		.split(',')
+		.map(normalizeText)
+		.filter(Boolean)
+}
+
+export function parseSafetyDate(value: unknown) {
+	if (value instanceof Date && !Number.isNaN(value.getTime())) {
+		return new Date(value.getFullYear(), value.getMonth(), value.getDate())
+	}
+
+	const text = String(value ?? '').trim()
+	if (!text) return null
+
+	const iso = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/)
+	if (iso) return validDate(Number(iso[1]), Number(iso[2]), Number(iso[3]))
+
+	const australian = text.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/)
+	if (australian) {
+		return validDate(Number(australian[3]), Number(australian[2]), Number(australian[1]))
+	}
+
+	const parsed = new Date(text)
+	if (Number.isNaN(parsed.getTime())) return null
+	return new Date(parsed.getFullYear(), parsed.getMonth(), parsed.getDate())
+}
+
+function validDate(year: number, month: number, day: number) {
+	const date = new Date(year, month - 1, day)
+	return date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day
+		? date
+		: null
+}
+
+export function safetyMonthKey(date: Date) {
+	return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`
+}
+
+export function safetyMonthLabel(key: string) {
+	if (!/^\d{4}-\d{2}$/.test(key)) return ''
+	const [year, month] = key.split('-').map(Number)
+	return new Intl.DateTimeFormat(undefined, {
+		month: 'long',
+		year: 'numeric',
+	}).format(new Date(year, month - 1, 1))
+}
+
+export function getSafetyStatuses(config: SafetyCrossChartConfig) {
+	return DEFAULT_STATUSES.map((status) => ({
+		...status,
+		label: config[`${status.key}_label` as keyof SafetyCrossChartConfig] || status.label,
+		values: config[`${status.key}_values` as keyof SafetyCrossChartConfig] || status.values,
+		color: config[`${status.key}_color` as keyof SafetyCrossChartConfig] || status.color,
+	})) as SafetyStatus[]
+}
+
+export function normalizeSafetyShift(value: unknown, config: SafetyCrossChartConfig) {
+	const normalized = normalizeText(value)
+	const dayAliases = [
+		'day',
+		'day shift',
+		'dayshift',
+		'ds',
+		'd',
+		...aliases(config.day_shift_values),
+	]
+	const nightAliases = [
+		'night',
+		'night shift',
+		'nightshift',
+		'ns',
+		'n',
+		...aliases(config.night_shift_values),
+	]
+	if (dayAliases.map(normalizeText).includes(normalized)) return 'day'
+	if (nightAliases.map(normalizeText).includes(normalized)) return 'night'
+	return null
+}
+
+export function resolveSafetyStatus(value: unknown, statuses: SafetyStatus[]) {
+	const normalized = normalizeText(value)
+	if (!normalized) return null
+	return (
+		statuses.find((status) =>
+			[...aliases(status.values), normalizeText(status.label)].includes(normalized),
+		) || null
+	)
+}
+
+export function getSafetyMonths(rows: QueryResultRow[], dateColumn: string) {
+	if (!dateColumn) return []
+	return [
+		...new Set(
+			rows
+				.map((row) => parseSafetyDate(row[dateColumn]))
+				.filter((date): date is Date => Boolean(date))
+				.map(safetyMonthKey),
+		),
+	].sort()
+}
+
+export function getInitialSafetyMonth(months: string[], mode = 'latest', fixedMonth = '') {
+	if (!months.length) return ''
+	if (fixedMonth && months.includes(fixedMonth)) return fixedMonth
+	if (mode === 'earliest') return months[0]
+	if (mode === 'current') {
+		const current = safetyMonthKey(new Date())
+		if (months.includes(current)) return current
+	}
+	return months[months.length - 1]
+}
+
+export function buildSafetyCross(
+	rows: QueryResultRow[],
+	config: SafetyCrossChartConfig,
+	selectedMonth: string,
+) {
+	const statuses = getSafetyStatuses(config)
+	const days: SafetyCrossDay[] = Array.from({ length: 31 }, (_, index) => ({
+		day: index + 1,
+		dayShift: null,
+		nightShift: null,
+	}))
+	const ignored = { invalidDate: 0, unknownShift: 0, unknownStatus: 0 }
+	const dateColumn = config.date_column?.dimension_name
+	const shiftColumn = config.shift_column?.dimension_name
+	const statusColumn = config.status_column?.dimension_name
+	const detailColumn = config.detail_column?.dimension_name
+
+	for (const row of rows) {
+		const date = parseSafetyDate(row[dateColumn])
+		if (!date) {
+			ignored.invalidDate += 1
+			continue
+		}
+		if (safetyMonthKey(date) !== selectedMonth) continue
+
+		const shift = normalizeSafetyShift(row[shiftColumn], config)
+		if (!shift) {
+			ignored.unknownShift += 1
+			continue
+		}
+
+		const status = resolveSafetyStatus(row[statusColumn], statuses)
+		if (!status) {
+			ignored.unknownStatus += 1
+			continue
+		}
+
+		const day = days[date.getDate() - 1]
+		const shiftKey = shift === 'day' ? 'dayShift' : 'nightShift'
+		const existing = day[shiftKey]
+		const count = Number(row.count_of_rows) || 1
+		const detail = detailColumn ? String(row[detailColumn] ?? '').trim() : ''
+
+		if (!existing) {
+			day[shiftKey] = {
+				...status,
+				count,
+				details: detail ? [detail] : [],
+			}
+			continue
+		}
+
+		const details =
+			detail && !existing.details.includes(detail)
+				? [...existing.details, detail]
+				: existing.details
+		day[shiftKey] =
+			status.severity > existing.severity
+				? { ...status, count: existing.count + count, details }
+				: { ...existing, count: existing.count + count, details }
+	}
+
+	return { days, statuses, ignored }
+}
+
+export function getSafetyCrossPosition(day: number) {
+	if (day <= 3) return { row: 1, column: day + 2 }
+	if (day <= 6) return { row: 2, column: day - 1 }
+	if (day <= 27) {
+		const offset = day - 7
+		return { row: 3 + Math.floor(offset / 7), column: 1 + (offset % 7) }
+	}
+	if (day <= 30) return { row: 6, column: day - 25 }
+	return { row: 7, column: 4 }
+}
