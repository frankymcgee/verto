diff --git a/frontend/src2/charts/components/SafetyCrossChart.vue b/frontend/src2/charts/components/SafetyCrossChart.vue
new file mode 100644
index 0000000..607a647
--- /dev/null
+++ b/frontend/src2/charts/components/SafetyCrossChart.vue
@@ -0,0 +1,202 @@
+<script setup lang="ts">
+import { ChevronLeft, ChevronRight } from 'lucide-vue-next'
+import { computed, ref, watch } from 'vue'
+import { SafetyCrossChartConfig } from '../../types/chart.types'
+import { QueryResult } from '../../types/query.types'
+import {
+	DEFAULT_EMPTY_COLOR,
+	buildSafetyCross,
+	getInitialSafetyMonth,
+	getSafetyCrossPosition,
+	getSafetyMonths,
+	safetyMonthLabel,
+} from '../safetyCross'
+import ChartTitle from './ChartTitle.vue'
+
+const props = defineProps<{
+	config: SafetyCrossChartConfig
+	result: QueryResult
+	title?: string
+}>()
+
+const rows = computed(() => props.result.formattedRows || props.result.rows || [])
+const availableMonths = computed(() =>
+	getSafetyMonths(rows.value, props.config.date_column?.dimension_name),
+)
+const selectedMonth = ref('')
+
+watch(
+	[availableMonths, () => props.config.month_mode, () => props.config.fixed_month],
+	([months]) => {
+		if (months.includes(selectedMonth.value) && !props.config.fixed_month) return
+		selectedMonth.value = getInitialSafetyMonth(
+			months,
+			props.config.month_mode,
+			props.config.fixed_month,
+		)
+	},
+	{ immediate: true },
+)
+
+const cross = computed(() => buildSafetyCross(rows.value, props.config, selectedMonth.value))
+const selectedMonthIndex = computed(() => availableMonths.value.indexOf(selectedMonth.value))
+const canGoPrevious = computed(() => selectedMonthIndex.value > 0)
+const canGoNext = computed(
+	() =>
+		selectedMonthIndex.value >= 0 &&
+		selectedMonthIndex.value < availableMonths.value.length - 1,
+)
+const emptyColor = computed(() => props.config.empty_color || DEFAULT_EMPTY_COLOR)
+const hasWarnings = computed(
+	() =>
+		cross.value.ignored.invalidDate +
+			cross.value.ignored.unknownShift +
+			cross.value.ignored.unknownStatus >
+		0,
+)
+
+function changeMonth(offset: number) {
+	const target = selectedMonthIndex.value + offset
+	if (target < 0 || target >= availableMonths.value.length) return
+	selectedMonth.value = availableMonths.value[target]
+}
+
+function tooltip(day: number, shiftName: string, shift: any) {
+	const lines = [
+		`${safetyMonthLabel(selectedMonth.value)} ${day}`,
+		shiftName,
+		shift?.label || props.config.empty_label || 'No record',
+	]
+	if (shift?.count > 1) lines.push(`${shift.count} records (highest severity shown)`)
+	if (shift?.details?.length) lines.push(shift.details.join(' • '))
+	return lines.join('\n')
+}
+</script>
+
+<template>
+	<div class="flex h-full w-full min-h-0 flex-col rounded bg-white py-1 shadow">
+		<ChartTitle v-if="props.title" :title="props.title" />
+
+		<div
+			v-if="!availableMonths.length"
+			class="flex flex-1 items-center justify-center p-6 text-center text-sm text-gray-500"
+		>
+			No valid dates were found in the selected date column.
+		</div>
+
+		<div v-else class="flex min-h-0 flex-1 flex-col px-3 pb-3">
+			<div class="mb-2 flex items-center justify-center gap-2">
+				<Button
+					v-if="props.config.show_month_navigation !== false"
+					variant="ghost"
+					:disabled="!canGoPrevious"
+					aria-label="Previous month with data"
+					@click="changeMonth(-1)"
+				>
+					<template #icon><ChevronLeft class="h-4 w-4" /></template>
+				</Button>
+				<div class="min-w-[9rem] text-center text-sm font-medium text-gray-700">
+					{{ safetyMonthLabel(selectedMonth) }}
+				</div>
+				<Button
+					v-if="props.config.show_month_navigation !== false"
+					variant="ghost"
+					:disabled="!canGoNext"
+					aria-label="Next month with data"
+					@click="changeMonth(1)"
+				>
+					<template #icon><ChevronRight class="h-4 w-4" /></template>
+				</Button>
+			</div>
+
+			<div
+				class="mx-auto grid min-h-0 w-full max-w-[38rem] flex-1 grid-cols-7 grid-rows-7 gap-1"
+				role="grid"
+				:aria-label="`Safety Cross for ${safetyMonthLabel(selectedMonth)}`"
+			>
+				<div
+					v-for="entry in cross.days"
+					:key="entry.day"
+					class="relative min-h-[2.15rem] overflow-hidden rounded-sm border border-white shadow-sm ring-1 ring-gray-200"
+					:style="{
+						gridRow: getSafetyCrossPosition(entry.day).row,
+						gridColumn: getSafetyCrossPosition(entry.day).column,
+					}"
+					role="gridcell"
+				>
+					<div
+						class="absolute inset-x-0 top-0 h-1/2"
+						:style="{ backgroundColor: entry.dayShift?.color || emptyColor }"
+						:title="
+							tooltip(
+								entry.day,
+								props.config.day_shift_label || 'Day Shift',
+								entry.dayShift,
+							)
+						"
+					/>
+					<div
+						class="absolute inset-x-0 bottom-0 h-1/2 border-t border-white/80"
+						:style="{ backgroundColor: entry.nightShift?.color || emptyColor }"
+						:title="
+							tooltip(
+								entry.day,
+								props.config.night_shift_label || 'Night Shift',
+								entry.nightShift,
+							)
+						"
+					/>
+					<div
+						class="pointer-events-none absolute inset-0 flex items-center justify-center"
+					>
+						<span
+							class="flex h-6 min-w-6 items-center justify-center rounded-full bg-white/90 px-1 text-xs font-semibold text-gray-800 shadow-sm"
+						>
+							{{ entry.day }}
+						</span>
+					</div>
+				</div>
+			</div>
+
+			<div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5">
+				<div
+					v-for="status in cross.statuses"
+					:key="status.key"
+					class="flex items-center gap-1.5 text-xs text-gray-600"
+				>
+					<span
+						class="h-2.5 w-2.5 rounded-sm ring-1 ring-black/10"
+						:style="{ backgroundColor: status.color }"
+					/>
+					<span>{{ status.label }}</span>
+				</div>
+				<div class="flex items-center gap-1.5 text-xs text-gray-600">
+					<span
+						class="h-2.5 w-2.5 rounded-sm ring-1 ring-black/10"
+						:style="{ backgroundColor: emptyColor }"
+					/>
+					<span>{{ props.config.empty_label || 'No record' }}</span>
+				</div>
+			</div>
+
+			<div class="mt-2 flex items-center justify-center gap-4 text-[11px] text-gray-500">
+				<span>
+					<strong class="font-semibold">Top:</strong>
+					{{ props.config.day_shift_label || 'Day Shift' }}
+				</span>
+				<span>
+					<strong class="font-semibold">Bottom:</strong>
+					{{ props.config.night_shift_label || 'Night Shift' }}
+				</span>
+			</div>
+
+			<div
+				v-if="hasWarnings && props.config.show_data_warnings !== false"
+				class="mt-1 text-center text-[11px] text-amber-700"
+				:title="`${cross.ignored.invalidDate} invalid dates, ${cross.ignored.unknownShift} unknown shifts, ${cross.ignored.unknownStatus} unknown statuses`"
+			>
+				Some rows could not be plotted. Hover for details.
+			</div>
+		</div>
+	</div>
+</template>
