+<script setup lang="ts">
+import { watchEffect } from 'vue'
+import { SafetyCrossChartConfig } from '../../types/chart.types'
+import { Dimension, DimensionOption } from '../../types/query.types'
+import { DEFAULT_EMPTY_COLOR, DEFAULT_STATUSES } from '../safetyCross'
+import CollapsibleSection from './CollapsibleSection.vue'
+import DimensionPicker from './DimensionPicker.vue'
+
+const props = defineProps<{ dimensions: DimensionOption[] }>()
+const config = defineModel<SafetyCrossChartConfig>({
+	required: true,
+	default: () => ({
+		date_column: {},
+		shift_column: {},
+		status_column: {},
+	}),
+})
+
+const monthModes = [
+	{ label: 'Latest month with data', value: 'latest' },
+	{ label: 'Earliest month with data', value: 'earliest' },
+	{ label: 'Current month (or latest)', value: 'current' },
+]
+
+watchEffect(() => {
+	config.value.date_column ||= {} as Dimension
+	config.value.shift_column ||= {} as Dimension
+	config.value.status_column ||= {} as Dimension
+	config.value.detail_column ||= {} as Dimension
+	config.value.month_mode ||= 'latest'
+	config.value.show_month_navigation ??= true
+	config.value.show_data_warnings ??= true
+	config.value.day_shift_label ||= 'Day Shift'
+	config.value.night_shift_label ||= 'Night Shift'
+	config.value.day_shift_values ||= 'Day Shift, DS, Day'
+	config.value.night_shift_values ||= 'Night Shift, NS, Night'
+	config.value.empty_label ||= 'No record'
+	config.value.empty_color ||= DEFAULT_EMPTY_COLOR
+
+	for (const status of DEFAULT_STATUSES) {
+		const labelKey = `${status.key}_label` as keyof SafetyCrossChartConfig
+		const valuesKey = `${status.key}_values` as keyof SafetyCrossChartConfig
+		const colorKey = `${status.key}_color` as keyof SafetyCrossChartConfig
+		config.value[labelKey] ||= status.label as never
+		config.value[valuesKey] ||= status.values as never
+		config.value[colorKey] ||= status.color as never
+	}
+})
+</script>
+
+<template>
+	<CollapsibleSection title="Safety Cross">
+		<div class="flex flex-col gap-3 pt-1">
+			<DimensionPicker
+				label="Date"
+				v-model="config.date_column"
+				:options="props.dimensions"
+			/>
+			<DimensionPicker
+				label="Shift"
+				v-model="config.shift_column"
+				:options="props.dimensions"
+			/>
+			<DimensionPicker
+				label="Safety Status"
+				v-model="config.status_column"
+				:options="props.dimensions"
+			/>
+			<DimensionPicker
+				label="Tooltip Detail (optional)"
+				v-model="config.detail_column"
+				:options="props.dimensions"
+			/>
+		</div>
+	</CollapsibleSection>
+
+	<CollapsibleSection title="Month" collapsed>
+		<div class="flex flex-col gap-3 pt-1">
+			<FormControl
+				v-model="config.month_mode"
+				label="Initial Month"
+				type="select"
+				:options="monthModes"
+			/>
+			<FormControl
+				v-model="config.fixed_month"
+				label="Lock to Month (optional)"
+				placeholder="YYYY-MM"
+			/>
+			<Toggle v-model="config.show_month_navigation" label="Show Month Navigation" />
+		</div>
+	</CollapsibleSection>
+
+	<CollapsibleSection title="Shift Mapping" collapsed>
+		<div class="flex flex-col gap-3 pt-1">
+			<FormControl v-model="config.day_shift_label" label="Day Shift Label" />
+			<FormControl
+				v-model="config.day_shift_values"
+				label="Day Shift Values"
+				description="Comma-separated aliases"
+			/>
+			<FormControl v-model="config.night_shift_label" label="Night Shift Label" />
+			<FormControl
+				v-model="config.night_shift_values"
+				label="Night Shift Values"
+				description="Comma-separated aliases"
+			/>
+		</div>
+	</CollapsibleSection>
+
+	<CollapsibleSection title="Status Mapping & Colours" collapsed>
+		<div class="flex flex-col gap-4 pt-1">
+			<div
+				v-for="status in DEFAULT_STATUSES"
+				:key="status.key"
+				class="flex flex-col gap-2 rounded border p-2.5"
+			>
+				<FormControl
+					v-model="config[`${status.key}_label` as keyof SafetyCrossChartConfig]"
+					label="Legend Label"
+				/>
+				<FormControl
+					v-model="config[`${status.key}_values` as keyof SafetyCrossChartConfig]"
+					label="Source Value(s)"
+					description="Comma-separated aliases"
+				/>
+				<label class="text-xs text-gray-600">
+					Colour
+					<div class="mt-1 flex items-center gap-2">
+						<input
+							v-model="config[`${status.key}_color` as keyof SafetyCrossChartConfig]"
+							type="color"
+							class="h-8 w-10 cursor-pointer rounded border bg-white p-1"
+						/>
+						<FormControl
+							v-model="config[`${status.key}_color` as keyof SafetyCrossChartConfig]"
+							class="flex-1"
+						/>
+					</div>
+				</label>
+			</div>
+
+			<div class="flex flex-col gap-2 rounded border p-2.5">
+				<FormControl v-model="config.empty_label" label="Empty Label" />
+				<label class="text-xs text-gray-600">
+					Empty Colour
+					<div class="mt-1 flex items-center gap-2">
+						<input
+							v-model="config.empty_color"
+							type="color"
+							class="h-8 w-10 cursor-pointer rounded border bg-white p-1"
+						/>
+						<FormControl v-model="config.empty_color" class="flex-1" />
+					</div>
+				</label>
+			</div>
+			<Toggle v-model="config.show_data_warnings" label="Show Data Warnings" />
+		</div>
+	</CollapsibleSection>
+</template>
