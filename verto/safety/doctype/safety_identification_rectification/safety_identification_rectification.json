  },
  {
   "description": "<b>Minor</b>: Minor injury such as first aid case.<br>\n<b>Moderate</b>: Moderate injury, occupational illness / restricted work case, medical treatment injury / illness.<br>\n<b>Serious</b>: Serious injuries including permanent disability or serious illness/lost time injury.<br>\n<b>Major</b>: Single fatality or chronic exposure resulting in a fatality.<br>\n<b>Severe</b>: Multiple fatalities (2-30) or chronic exposure resulting in multiple fatalities.<br>\n<b>Catastrophic</b>: Multiple fatalities (&gt;30) or chronic exposure resulting in multiple fatalities.<br>",
   "fieldname": "applicable_health_and_safety_consequence",
   "fieldtype": "Select",
   "label": "Applicable Health and Safety Consequence",
   "options": "\nMinor\nModerate\nSerious\nMajor\nSevere\nCatastrophic"
  },
  {
   "description": "<b>Elimination</b>: Removes the hazard entirely from the area the hazard was present.<br>\n<b>Substitution</b>: Replaces the hazard with a something less hazardous.<br>\n<b>Isolation</b>: Isolates the hazard by guarding, barricading or enclosing it.<br>\n<b>Engineering</b>: Redesign the workplace, tools and equipment.<br>\n<b>Administration</b>: Procedures and documented processes used by personnel exposed to hazards.<br>\n<b>Personal Protective Equipment</b>: Protective barriers worn by personnel exposed to hazards.<br>",
   "fieldname": "hierarchy_of_control_applicable",
   "fieldtype": "Select",
   "label": "Hierarchy of Control Applicable",
   "options": "\nElimination\nSubstitution\nIsolation\nEngineering\nAdministration\nPersonal Protective Equipment"
  },
  {
   "fieldname": "if_there_is_an_immediate_risk_has_this_been_controlled",
