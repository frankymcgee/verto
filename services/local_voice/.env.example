# Use the exact Frappe site directory name. One service pair per tenant.
VERTO_VOICE_TENANT=mss.webwire.cloud
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
VERTO_VOICE_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
# Conservative pilot limit; increase only after measuring the complete workflow.
VERTO_VOICE_MAX_SESSIONS=4
VERTO_STT_MODEL=small.en
VERTO_STT_DEVICE=cpu
VERTO_STT_COMPUTE_TYPE=int8
VERTO_STT_CPU_THREADS=4
VERTO_TTS_DEVICE=cpu
VERTO_TTS_CPU_THREADS=4
